{
  "name": "@carbotracker/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:carbotracker": "npx nx serve carbotracker",
    "start:carbotracker:local": "npx nx serve:firebase-emulated carbotracker",
    "prettier:check": "npx nx format:check --all",
    "prettier:write": "npx nx format:write --all",
    "ci:check-formatting": "npm run prettier:check",
    "ci:lint": "npx nx affected --target=lint --base=origin/main",
    "ci:test": "npx nx affected --target=test --base=origin/main --codeCoverage=true --coverageReporters=text",
    "test:tools": "bash tools/tests/ct-lib.test.sh && bash tools/tests/ct-orchestrator.test.sh && bash tools/tests/ct-orchestrator-setup.test.sh",
    "orchestrator:run": "bash tools/ct-orchestrator.sh",
    "orchestrator:once": "bash tools/ct-orchestrator.sh once",
    "ci:build": "npx nx affected --target=build --base=origin/main",
    "ci:build:pullrequest": "npx nx affected --target=build --configuration=pr-preview --base=origin/main",
    "worktree:start": "bash tools/ct-worktree.sh start",
    "worktree:list": "bash tools/ct-worktree.sh list",
    "worktree:ls": "bash tools/ct-worktree.sh list",
    "worktree:prune": "bash tools/ct-worktree.sh prune"
  },
  "private": true,
